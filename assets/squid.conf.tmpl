# Generated by ais. Do not edit; the allowlist is composed from the task
# definitions, the config and the extra.acl file, and 'ais egress reload'
# re-renders this.
http_port {{.Port}}
visible_hostname {{.ProxyName}}

# The audit trail: one line per request. Written to the log directory the
# image owns and forwarded to stdout by the image's entrypoint (tail -F);
# writing /dev/stdout directly fails under rootful docker because squid
# drops to the "proxy" user and the pipe belongs to root.
access_log stdio:/var/log/squid/access.log squid
logfile_rotate 0
cache deny all
shutdown_lifetime 1 seconds

# Only the internal network may use the proxy.
acl ais_clients src {{.Subnet}}
acl allowed dstdomain "{{.AllowlistPath}}"
acl CONNECT method CONNECT

# The domain allowlist is the enforcement, not the port: an allowlisted host
# works on whatever port it serves, a host you did not allow is denied on
# every port.
http_access allow ais_clients allowed
http_access deny all
